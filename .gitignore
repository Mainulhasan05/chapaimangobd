# ============================================
# Chapai Mango Monorepo Root .gitignore
# ============================================

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js
package-lock.json.bak

# Environment & Secrets (Never commit secrets)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Build Outputs & Bundles
!client/dist/
!client/dist/**
dist-ssr/
**/dist-ssr/
build/
**/build/
out/
**/out/
.next/

# Logs
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Uploads & Temporary Directories
uploads/
**/uploads/
tmp/
**/tmp/
temp/
**/temp/
scratch/
**/scratch/
*.tmp
*.temp

# Test & Coverage Files
coverage/
**/coverage/
.nyc_output/
test_*.js
**/test_*.js

# OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Configurations
.idea/
.vscode/
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# Caches
.eslintcache
.cache/
**/.cache/
.turbo/
